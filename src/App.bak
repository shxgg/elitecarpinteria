

import { FormEvent, useEffect, useMemo, useState } from 'react';
import {
  ArrowDown,
  ArrowLeft,
  ArrowRight,
  ArrowUpRight,
  Check,
  ChevronDown,
  Image as ImageIcon,
  Instagram,
  Mail,
  MapPin,
  Menu,
  MessageCircle,
  Package,
  PenTool,
  Plus,
  Minus,
  Ruler,
  ShieldCheck,
  ShoppingBag,
  Sparkles,
  Trash2,
  Truck,
  X,
} from 'lucide-react';
import { materialSamples, products as initialProducts, quickCategories } from '@/data/products';
import { supabase } from './supabase';

export type CartItem = {
  id: string;
  name: string;
  price: number;
  quantity: number;
  image: string;
};

export default function App() {
  const [route, setRoute] = useState<Route>(getRoute);
  const [menuOpen, setMenuOpen] = useState(false);
  const [cartOpen, setCartOpen] = useState(false);
  const [cart, setCart] = useState<CartItem[]>([]);
  
  const [products, setProducts] = useState<any[]>(initialProducts);
  const [categories, setCategories] = useState<string[]>(['Amoblamientos de cocina', 'Revestimientos', 'Placards', 'Muebles a medida']);
  
  const [settings, setSettings] = useState({
    hero_title: 'Diseño de origen para espacios que viven con vos.',
    phone: '+54 11 2408-9472',
    email: 'matias@elitecarpinteria.com.ar',
    whatsapp: '5491124089472',
    favicon_url: '/logo.png',
    about_title: 'Un taller con los pies en el origen.',
    about_text: 'Somos una carpintería argentina que trabaja con aglomerado y melamina.',
    about_image: 'https://images.pexels.com/photos/7484794/pexels-photo-7484794.jpeg?auto=compress&cs=tinysrgb&w=1200',
  });

  const WHATSAPP_URL = `https://wa.me/${settings.whatsapp.replace(/\D/g, '')}`;
  const WHATSAPP_MESSAGE = 'Hola Elite, quisiera consultar por un mueble a medida.';
  const whatsappLink = (message = WHATSAPP_MESSAGE) => `${WHATSAPP_URL}?text=${encodeURIComponent(message)}`;

  const addToCart = (product: any) => {
    setCart((prev) => {
      const existing = prev.find((item) => item.id === product.id);
      if (existing) {
        return prev.map((item) => (item.id === product.id ? { ...item, quantity: item.quantity + 1 } : item));
      }
      return [...prev, { id: product.id, name: product.name, price: product.price || 0, quantity: 1, image: product.image }];
    });
    setCartOpen(true);
  };

  const updateQuantity = (id: string, delta: number) => {
    setCart((prev) =>
      prev
        .map((item) => {
          if (item.id === id) {
            const newQty = item.quantity + delta;
            return newQty > 0 ? { ...item, quantity: newQty } : null;
          }
          return item;
        })
        .filter(Boolean) as CartItem[]
    );
  };

  const removeFromCart = (id: string) => {
    setCart((prev) => prev.filter((item) => item.id !== id));
  };

  const totalCartPrice = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);

  const sendCartToWhatsApp = () => {
    if (cart.length === 0) return;
    let message = `🛒 *NUEVO PEDIDO DESDE LA WEB*\n\n`;
    cart.forEach((item, index) => {
      const itemPrice = item.price > 0 ? `$${(item.price * item.quantity).toLocaleString('es-AR')}` : 'A consultar';
      message += `${index + 1}. *${item.name}* x${item.quantity} - ${itemPrice}\n`;
    });
    message += `\n💰 *Total Estimado:* ${totalCartPrice > 0 ? `$${totalCartPrice.toLocaleString('es-AR')}` : 'A consultar'}\n\n`;
    message += `Hola Elite, quisiera coordinar la compra/presupuesto de estos productos.`;

    window.open(whatsappLink(message), '_blank', 'noopener,noreferrer');
  };

  useEffect(() => {
    async function fetchData() {
      const { data: prodData } = await supabase.from('products').select('*');
      if (prodData && prodData.length > 0) {
        const formatted = prodData.map((item: any) => ({
          id: item.id,
          name: item.title,
          description: item.description,
          category: item.category,
          kind: 'A medida',
          image: item.image_url,
          gallery: [item.image_url],
          details: item.description,
          referenceMeasures: 'A medida según espacio',
          material: 'Melamina / Aglomerado',
          colors: ['Blanco', 'Roble', 'Negro'],
          price: item.price || 0,
        }));
        setProducts(formatted);
      }

      const { data: catData } = await supabase.from('categories').select('*');
      if (catData && catData.length > 0) {
        setCategories(catData.map((c: any) => c.name));
      }

      const { data: setmData } = await supabase.from('site_settings').select('*').eq('id', 1).single();
      if (setmData) {
        setSettings({
          hero_title: setmData.hero_title || settings.hero_title,
          phone: setmData.phone || settings.phone,
          email: setmData.email || settings.email,
          whatsapp: setmData.whatsapp || settings.whatsapp,
          favicon_url: setmData.favicon_url || '/logo.png',
          about_title: setmData.about_title || settings.about_title,
          about_text: setmData.about_text || settings.about_text,
          about_image: setmData.about_image || settings.about_image,
        });

        if (setmData.favicon_url) {
          let link: HTMLLinkElement | null = document.querySelector("link[rel*='icon']");
          if (!link) {
            link = document.createElement('link');
            link.rel = 'shortcut icon';
            document.getElementsByTagName('head')[0].appendChild(link);
          }
          link.href = setmData.favicon_url;
        }
      }
    }
    fetchData();
  }, [route]);

  useEffect(() => {
    const handlePopState = () => setRoute(getRoute());
    window.addEventListener('popstate', handlePopState);
    return () => window.removeEventListener('popstate', handlePopState);
  }, []);

  useEffect(() => {
    const pageTitles: Record<string, string> = {
      '/': 'Elite | Carpintería de Origen',
      '/muebles': 'Muebles a medida y en serie | Elite',
      '/a-medida': 'Muebles a medida | Elite Carpintería',
      '/materiales': 'Materiales | Elite Carpintería',
      '/nosotros': 'Nosotros | Elite Carpintería',
      '/contacto': 'Contacto | Elite Carpintería',
      '/admin': 'Panel de Administración | Elite',
    };
    const product = products.find((item) => `/muebles/${item.id}` === route);
    document.title = product ? `${product.name} | Elite Carpintería` : pageTitles[route] ?? pageTitles['/'];
    window.scrollTo({ top: 0, behavior: 'instant' });
  }, [route, products]);

  function navigate(path: string) {
    window.history.pushState({}, '', path);
    setRoute(path as Route);
    setMenuOpen(false);
  }

  const cartTotalItems = cart.reduce((sum, item) => sum + item.quantity, 0);

  return (
    <div className="min-h-screen bg-bone text-charcoal">
      {route !== '/admin' && <TopNotice />}
      {route !== '/admin' && (
        <Header
          menuOpen={menuOpen}
          setMenuOpen={setMenuOpen}
          navigate={navigate}
          whatsappLink={whatsappLink}
          cartCount={cartTotalItems}
          onOpenCart={() => setCartOpen(true)}
        />
      )}

      {/* DRAWER DEL CARRITO DE COMPRAS */}
      {cartOpen && (
        <div className="fixed inset-0 z-50 flex justify-end bg-charcoal/60 backdrop-blur-sm">
          <div className="flex h-full w-full max-w-md flex-col bg-bone p-6 shadow-2xl">
            <div className="flex items-center justify-between border-b border-charcoal/10 pb-4">
              <div className="flex items-center gap-2">
                <ShoppingBag size={20} className="text-wood" />
                <h2 className="font-display text-2xl font-bold">Tu Pedido ({cartTotalItems})</h2>
              </div>
              <button onClick={() => setCartOpen(false)} className="rounded-full p-2 hover:bg-stone-light">
                <X size={20} />
              </button>
            </div>

            <div className="flex-1 overflow-y-auto py-4 space-y-4">
              {cart.length === 0 ? (
                <div className="flex h-full flex-col items-center justify-center text-center text-stone">
                  <ShoppingBag size={48} className="mb-3 stroke-1 text-stone/50" />
                  <p className="text-sm font-semibold">El carrito está vacío</p>
                  <p className="text-xs text-stone/80 mt-1">Explorá nuestros muebles y agregá lo que te guste.</p>
                </div>
              ) : (
                cart.map((item) => (
                  <div key={item.id} className="flex gap-4 border-b border-charcoal/10 pb-4 bg-white p-3 rounded shadow-sm">
                    <img src={item.image} alt={item.name} className="h-20 w-20 object-cover rounded shrink-0" />
                    <div className="flex flex-1 flex-col justify-between">
                      <div>
                        <div className="flex justify-between">
                          <h4 className="font-display text-base font-bold leading-tight">{item.name}</h4>
                          <button onClick={() => removeFromCart(item.id)} className="text-stone hover:text-red-600">
                            <Trash2 size={16} />
                          </button>
                        </div>
                        <p className="text-xs font-bold text-wood mt-1">
                          {item.price > 0 ? `$${item.price.toLocaleString('es-AR')}` : 'A consultar'}
                        </p>
                      </div>
                      <div className="flex items-center gap-3">
                        <div className="flex items-center border border-charcoal/20 rounded bg-bone">
                          <button onClick={() => updateQuantity(item.id, -1)} className="p-1 text-stone hover:text-charcoal">
                            <Minus size={14} />
                          </button>
                          <span className="px-2 text-xs font-bold">{item.quantity}</span>
                          <button onClick={() => updateQuantity(item.id, 1)} className="p-1 text-stone hover:text-charcoal">
                            <Plus size={14} />
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                ))
              )}
            </div>

            {cart.length > 0 && (
              <div className="border-t border-charcoal/10 pt-4 space-y-4">
                <div className="flex justify-between items-center text-base font-bold">
                  <span>Total estimado:</span>
                  <span className="text-xl text-charcoal">
                    {totalCartPrice > 0 ? `$${totalCartPrice.toLocaleString('es-AR')}` : 'A consultar'}
                  </span>
                </div>
                <button onClick={sendCartToWhatsApp} className="button-dark w-full justify-center py-4 text-xs font-bold uppercase tracking-wider">
                  Enviar Pedido por WhatsApp <MessageCircle size={18} />
                </button>
              </div>
            )}
          </div>
        </div>
      )}

      <main>
        {route === '/' && <Home navigate={navigate} products={products} settings={settings} whatsappLink={whatsappLink} addToCart={addToCart} />}
        {route === '/muebles' && <Catalog navigate={navigate} products={products} categories={categories} addToCart={addToCart} />}
        {route.startsWith('/muebles/') && (
          <ProductDetail
            product={products.find((item) => `/muebles/${item.id}` === route) ?? products[0]}
            navigate={navigate}
            whatsappLink={whatsappLink}
            addToCart={addToCart}
          />
        )}
        {route === '/a-medida' && <CustomMade whatsappLink={whatsappLink} />}
        {route === '/materiales' && <Materials />}
        {route === '/nosotros' && <About navigate={navigate} settings={settings} />}
        {route === '/contacto' && <Contact settings={settings} whatsappLink={whatsappLink} />}
        {route === '/admin' && <Admin navigate={navigate} categories={categories} onCategoryAdded={() => window.location.reload()} />}
      </main>

      {route !== '/admin' && <Footer navigate={navigate} settings={settings} />}
      {route !== '/admin' && <WhatsAppButton whatsappLink={whatsappLink} />}
    </div>
  );
}

type Route = '/' | '/muebles' | '/a-medida' | '/materiales' | '/nosotros' | '/contacto' | '/admin' | `/muebles/${string}`;

function getRoute(): Route {
  const path = window.location.pathname.replace(/\/$/, '') || '/';
  if (path === '/admin') return '/admin';
  if (path.startsWith('/muebles/')) return path as Route;
  if (['/', '/muebles', '/a-medida', '/materiales', '/nosotros', '/contacto', '/admin'].includes(path)) return path as Route;
  return '/';
}

function TopNotice() {
  return <div className="bg-charcoal px-4 py-2 text-center text-[10px] font-semibold uppercase tracking-[0.15em] text-white/75">Fabricación propia <span className="mx-2 text-wood">·</span> Muebles a medida <span className="mx-2 text-wood">·</span> Envíos a todo el país</div>;
}

type HeaderProps = {
  menuOpen: boolean;
  setMenuOpen: (value: boolean) => void;
  navigate: (path: string) => void;
  whatsappLink: () => string;
  cartCount: number;
  onOpenCart: () => void;
};

function Header({ menuOpen, setMenuOpen, navigate, whatsappLink, cartCount, onOpenCart }: HeaderProps) {
  const links = [['Muebles', '/muebles'], ['A medida', '/a-medida'], ['Materiales', '/materiales'], ['Nosotros', '/nosotros'], ['Contacto', '/contacto']];
  return (
    <header className="sticky top-0 z-40 border-b border-charcoal/10 bg-bone/95 backdrop-blur-md">
      <div className="mx-auto flex max-w-[1320px] items-center justify-between px-5 py-4 lg:px-10">
        <button onClick={() => navigate('/')} className="group text-left" aria-label="Ir al inicio">
          <img src="/logo.png" alt="Elite | Carpintería de Origen" className="h-12 w-16 object-contain object-left" />
        </button>
        <nav className="hidden items-center gap-7 lg:flex">
          {links.map(([label, path]) => (
            <button key={path} onClick={() => navigate(path)} className="text-[11px] font-semibold uppercase tracking-[0.14em] text-charcoal/65 transition-colors hover:text-wood">
              {label}
            </button>
          ))}
        </nav>
        <div className="flex items-center gap-3">
          <button onClick={onOpenCart} className="relative flex items-center gap-2 border border-charcoal/15 px-3 py-2 text-[11px] font-bold uppercase tracking-[0.14em] text-charcoal hover:bg-stone-light">
            <ShoppingBag size={18} />
            <span className="hidden sm:inline">Carrito</span>
            {cartCount > 0 && <span className="flex h-5 w-5 items-center justify-center rounded-full bg-wood text-[10px] text-white">{cartCount}</span>}
          </button>
          <a href={whatsappLink()} target="_blank" rel="noreferrer" className="hidden items-center gap-2 bg-wood px-4 py-3 text-[10px] font-bold uppercase tracking-[0.14em] text-white transition-colors hover:bg-charcoal sm:flex">
            Pedir presupuesto <ArrowUpRight size={14} />
          </a>
          <button onClick={() => setMenuOpen(!menuOpen)} className="rounded-full border border-charcoal/15 p-2 lg:hidden" aria-label="Abrir menú">
            {menuOpen ? <X size={19} /> : <Menu size={19} />}
          </button>
        </div>
      </div>
      {menuOpen && (
        <div className="border-t border-charcoal/10 bg-bone px-5 py-5 lg:hidden">
          <nav className="flex flex-col gap-5">
            {links.map(([label, path]) => (
              <button key={path} onClick={() => navigate(path)} className="text-left text-[11px] font-bold uppercase tracking-[0.16em]">{label}</button>
            ))}
            <a href={whatsappLink()} target="_blank" rel="noreferrer" className="flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.16em] text-wood">
              <MessageCircle size={16} /> Pedir presupuesto
            </a>
          </nav>
        </div>
      )}
    </header>
  );
}

function Home({ navigate, products, settings, whatsappLink, addToCart }: { navigate: (path: string) => void; products: any[]; settings: any; whatsappLink: (msg?: string) => string; addToCart: (product: any) => void }) {
  return (
    <>
      <section className="relative min-h-[680px] overflow-hidden bg-charcoal text-white lg:min-h-[calc(100vh-74px)]">
        <img src="/WhatsApp_Image_2026-10-28_at_10.46.54_(2).jpeg" alt="Mueble de living realizado por Elite Carpintería" className="absolute inset-0 h-full w-full object-cover opacity-75" loading="eager" />
        <div className="absolute inset-0 bg-gradient-to-r from-charcoal via-charcoal/55 to-charcoal/10" />
        <div className="relative mx-auto flex min-h-[680px] max-w-[1320px] items-end px-5 pb-20 pt-24 lg:min-h-[calc(100vh-74px)] lg:px-10 lg:pb-28">
          <div className="max-w-[720px] animate-rise">
            <p className="eyebrow text-wood-light">Elite <span className="mx-2 text-white/40">/</span> Diseño de origen</p>
            <h1 className="mt-6 font-display text-5xl leading-[.96] tracking-[-.045em] sm:text-7xl lg:text-[7rem]">
              Diseño de origen<br /><em className="text-wood-light">{settings.hero_title}</em>
            </h1>
            <p className="mt-8 max-w-[430px] text-base leading-7 text-white/75">Diseñamos y fabricamos muebles en aglomerado y melamina para que tu casa tenga exactamente lo que necesitás.</p>
            <div className="mt-9 flex flex-wrap gap-3">
              <button onClick={() => navigate('/muebles')} className="button-primary">Ver muebles <ArrowRight size={16} /></button>
              <a href={whatsappLink()} target="_blank" rel="noreferrer" className="button-outline">Cotizá por WhatsApp <MessageCircle size={16} /></a>
            </div>
          </div>
        </div>
      </section>

      <FeaturedProducts navigate={navigate} products={products} addToCart={addToCart} />
      <Process />
      <Benefits />
      <Testimonials />
      <FinalCta whatsappLink={whatsappLink} />
    </>
  );
}

function SectionHeading({ eyebrow, title, copy }: { eyebrow: string; title: React.ReactNode; copy?: string }) {
  return (
    <div className="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
      <div><p className="eyebrow">{eyebrow}</p><h2 className="section-title mt-4">{title}</h2></div>
      {copy && <p className="max-w-[320px] text-sm leading-6 text-stone">{copy}</p>}
    </div>
  );
}

function FeaturedProducts({ navigate, products, addToCart }: { navigate: (path: string) => void; products: any[]; addToCart: (p: any) => void }) {
  return (
    <section className="bg-white px-5 py-20 lg:px-10 lg:py-28">
      <div className="mx-auto max-w-[1320px]">
        <SectionHeading eyebrow="01 / Muebles destacados" title={<>Diseñados para <em>quedarse.</em></>} copy="Algunos modelos para inspirarte. Todo se puede adaptar a tus medidas y necesidades." />
        <div className="mt-12 grid gap-x-5 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
          {products.slice(0, 4).map((product) => (
            <ProductCard key={product.id} product={product} navigate={navigate} addToCart={addToCart} />
          ))}
        </div>
        <div className="mt-14 text-center">
          <button onClick={() => navigate('/muebles')} className="button-dark">Ver todos los muebles <ArrowRight size={16} /></button>
        </div>
      </div>
    </section>
  );
}

function ProductCard({ product, navigate, addToCart }: { product: any; navigate: (path: string) => void; addToCart: (p: any) => void }) {
  const formattedPrice = product.price && product.price > 0 
    ? new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(product.price)
    : 'A consultar';

  return (
    <article className="group flex flex-col justify-between">
      <div>
        <button onClick={() => navigate(`/muebles/${product.id}`)} className="block w-full text-left">
          <div className="relative aspect-[.88] overflow-hidden bg-stone-light">
            <img src={product.image} alt={`${product.name}`} className="h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <span className="absolute left-3 top-3 bg-bone/90 px-3 py-2 text-[9px] font-bold uppercase tracking-[0.14em] text-charcoal">{product.kind}</span>
          </div>
          <div className="pt-4">
            <div className="flex justify-between items-center">
              <p className="text-[9px] font-bold uppercase tracking-[0.17em] text-wood">{product.category}</p>
              <span className="text-xs font-bold text-charcoal">{formattedPrice}</span>
            </div>
            <h3 className="mt-2 font-display text-2xl">{product.name}</h3>
            <p className="mt-2 text-sm leading-6 text-stone line-clamp-2">{product.description}</p>
          </div>
        </button>
      </div>
      <button onClick={() => addToCart(product)} className="mt-4 flex items-center justify-center gap-2 border border-charcoal/20 py-2.5 text-[10px] font-bold uppercase tracking-[0.13em] text-charcoal hover:bg-charcoal hover:text-white transition-colors">
        <Plus size={14} /> Agregar al Carrito
      </button>
    </article>
  );
}

function Process() {
  const steps = [['01', 'Consulta', 'Nos contás qué necesitás, dónde va y cómo te gustaría que se sienta.'], ['02', 'Diseño y medidas', 'Pensamos la distribución y definimos medidas, material, color y detalles.'], ['03', 'Fabricación', 'Cortamos, canteamos y armamos en nuestro taller con atención en cada terminación.'], ['04', 'Entrega e instalación', 'Coordinamos la entrega y dejamos tu mueble listo para usar.']];
  return (
    <section className="bg-bone px-5 py-20 lg:px-10 lg:py-28">
      <div className="mx-auto max-w-[1320px]">
        <SectionHeading eyebrow="02 / Cómo trabajamos" title={<>De la idea a tu casa, <em>sin vueltas.</em></>} />
        <div className="mt-14 grid gap-0 border-t border-charcoal/15 md:grid-cols-4">
          {steps.map(([number, title, copy]) => (
            <div key={number} className="border-b border-charcoal/15 py-7 md:border-b-0 md:border-r md:px-6 md:first:pl-0 md:last:border-r-0">
              <span className="font-display text-3xl text-wood">{number}</span>
              <h3 className="mt-7 font-display text-2xl">{title}</h3>
              <p className="mt-3 text-sm leading-6 text-stone">{copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  );
}

function Benefits() {
  const benefits = [[PenTool, 'Fabricación propia', 'Lo hacemos en nuestro taller, de principio a fin.'], [Ruler, 'A medida o en serie', 'Una pieza única o un modelo repetible, según tu proyecto.'], [Truck, 'Envíos a todo el país', 'Coordinamos la logística para que llegue a donde estés.'], [Sparkles, 'Atención personalizada', 'Te acompañamos para tomar buenas decisiones.']];
  return (
    <section className="border-y border-charcoal/10 bg-white px-5 py-16 lg:px-10">
      <div className="mx-auto grid max-w-[1320px] gap-9 sm:grid-cols-2 lg:grid-cols-4">
        {benefits.map(([Icon, title, copy]) => (
          <div key={title as string} className="flex gap-4">
            <Icon size={22} strokeWidth={1.4} className="shrink-0 text-wood" />
            <div><h3 className="text-sm font-bold">{title as string}</h3><p className="mt-2 text-xs leading-5 text-stone">{copy as string}</p></div>
          </div>
        ))}
      </div>
    </section>
  );
}

function Testimonials() {
  const testimonials = [['“Nos ayudaron a ordenar una cocina complicada y el resultado quedó impecable. Se nota el cuidado en cada detalle.”', 'Lucía M. · Colegiales'], ['“Pedimos un placard con medidas muy específicas y cumplieron con los tiempos y la instalación.”', 'Tomás R. · Vicente López'], ['“El escritorio quedó hermoso y mucho más sólido de lo que esperábamos. La atención fue muy clara.”', 'Sofía G. · La Plata']];
  return (
    <section className="bg-bone px-5 py-20 lg:px-10 lg:py-28">
      <div className="mx-auto max-w-[1320px]">
        <SectionHeading eyebrow="03 / Lo que dicen" title={<>Hecho para la vida <em>real.</em></>} />
        <div className="mt-12 grid gap-5 md:grid-cols-3">
          {testimonials.map(([quote, author]) => (
            <blockquote key={author} className="border border-charcoal/12 bg-white p-7">
              <span className="font-display text-4xl text-wood">“</span>
              <p className="mt-2 font-display text-xl leading-8">{quote.replace(/[“”]/g, '')}</p>
              <footer className="mt-7 text-[10px] font-bold uppercase tracking-[0.15em] text-stone">{author}</footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>
  );
}

function FinalCta({ whatsappLink }: { whatsappLink: (msg?: string) => string }) {
  return (
    <section className="bg-wood px-5 py-20 text-white lg:px-10 lg:py-24">
      <div className="mx-auto flex max-w-[1120px] flex-col items-start justify-between gap-8 md:flex-row md:items-center">
        <div><p className="eyebrow text-white/70">Tu próximo mueble</p><h2 className="mt-4 font-display text-4xl tracking-[-.03em] sm:text-6xl">Contanos qué necesitás.</h2></div>
        <a href={whatsappLink()} target="_blank" rel="noreferrer" className="button-light">Hablar por WhatsApp <MessageCircle size={17} /></a>
      </div>
    </section>
  );
}

function Catalog({ navigate, products, categories, addToCart }: { navigate: (path: string) => void; products: any[]; categories: string[]; addToCart: (p: any) => void }) {
  const [filter, setFilter] = useState<string>('Todos');
  const filtered = useMemo(() => filter === 'Todos' ? products : products.filter((product) => product.category === filter), [filter, products]);
  return (
    <PageIntro eyebrow="Colección Elite" title={<>Muebles que se adaptan<br /><em>a tu manera de vivir.</em></>} copy="Explorá nuestros modelos de referencia. Cada producto puede personalizarse en medidas, color y distribución." pageClass="bg-white">
      <div className="mx-auto max-w-[1320px] px-5 pb-24 lg:px-10">
        <div className="flex gap-2 overflow-x-auto border-b border-charcoal/15 pb-3">
          {['Todos', ...categories].map((category) => (
            <button key={category} onClick={() => setFilter(category)} className={`whitespace-nowrap px-3 py-2 text-[10px] font-bold uppercase tracking-[0.13em] ${filter === category ? 'border-b-2 border-wood text-wood' : 'text-stone hover:text-charcoal'}`}>
              {category}
            </button>
          ))}
        </div>
        <div className="mt-10 grid gap-x-5 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
          {filtered.map((product) => (
            <ProductCard key={product.id} product={product} navigate={navigate} addToCart={addToCart} />
          ))}
        </div>
      </div>
    </PageIntro>
  );
}

function PageIntro({ eyebrow, title, copy, children, pageClass = 'bg-bone' }: { eyebrow: string; title: React.ReactNode; copy: string; children: React.ReactNode; pageClass?: string }) {
  return <div className={pageClass}><section className="border-b border-charcoal/10 px-5 pb-16 pt-20 lg:px-10 lg:pb-24 lg:pt-28"><div className="mx-auto max-w-[1320px]"><p className="eyebrow">{eyebrow}</p><h1 className="mt-5 font-display text-5xl leading-[.98] tracking-[-.04em] sm:text-7xl">{title}</h1><p className="mt-7 max-w-[500px] text-base leading-7 text-stone">{copy}</p></div></section>{children}</div>;
}

function ProductDetail({ product, navigate, whatsappLink, addToCart }: { product: any; navigate: (path: string) => void; whatsappLink: (msg?: string) => string; addToCart: (p: any) => void }) {
  const formattedPrice = product.price && product.price > 0 
    ? new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(product.price)
    : 'Precio a consultar';

  return (
    <div className="bg-bone">
      <section className="mx-auto grid max-w-[1320px] gap-10 px-5 py-12 lg:grid-cols-[1.15fr_.85fr] lg:gap-20 lg:px-10 lg:py-20">
        <div className="grid grid-cols-2 gap-3">
          <div className="col-span-2 aspect-[1.4] overflow-hidden bg-stone-light">
            <img src={product.gallery?.[0] || product.image} alt={product.name} className="h-full w-full object-cover" />
          </div>
        </div>
        <div className="self-center">
          <button onClick={() => navigate('/muebles')} className="mb-10 flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.16em] text-stone hover:text-wood">
            <ArrowLeft size={14} /> Volver a muebles
          </button>
          <p className="eyebrow">{product.category}</p>
          <h1 className="mt-4 font-display text-5xl leading-none tracking-[-.04em] sm:text-6xl">{product.name}</h1>
          <div className="mt-4 flex items-center gap-4">
            <span className="inline-block border border-wood px-3 py-2 text-[10px] font-bold uppercase tracking-[0.15em] text-wood">{product.kind}</span>
            <span className="text-2xl font-bold text-charcoal">{formattedPrice}</span>
          </div>
          <p className="mt-8 text-base leading-7 text-stone">{product.details}</p>
          <div className="mt-10 grid gap-5 border-y border-charcoal/15 py-6 text-sm sm:grid-cols-2">
            <div><p className="detail-label">Medidas de referencia</p><p className="mt-2">{product.referenceMeasures}</p></div>
            <div><p className="detail-label">Material</p><p className="mt-2">{product.material}</p></div>
          </div>
          <div className="mt-9 flex flex-col sm:flex-row gap-3">
            <button onClick={() => addToCart(product)} className="button-dark flex-1 justify-center">
              <Plus size={16} /> Agregar al Carrito
            </button>
            <a href={whatsappLink(`Hola Elite, quisiera consultar por ${product.name} (${formattedPrice}).`)} target="_blank" rel="noreferrer" className="button-outline flex-1 justify-center">
              Consultar por WhatsApp <MessageCircle size={16} />
            </a>
          </div>
        </div>
      </section>
    </div>
  );
}

function CustomMade({ whatsappLink }: { whatsappLink: (msg?: string) => string }) {
  return (
    <PageIntro eyebrow="El servicio" title={<>Un mueble a medida<br /><em>empieza por escucharte.</em></>} copy="Diseñamos cada pieza alrededor de tu espacio, tus hábitos y tu forma de usarlo." pageClass="bg-bone">
      <section className="mx-auto grid max-w-[1320px] gap-12 px-5 py-16 lg:grid-cols-[.8fr_1.2fr] lg:px-10 lg:py-24">
        <div><p className="eyebrow">Diseño que resuelve</p><h2 className="mt-4 font-display text-4xl leading-tight">La medida justa no es solo un número.</h2><p className="mt-6 text-sm leading-7 text-stone">Es entender cómo circulás, qué querés guardar, dónde necesitás apoyo y qué querés ver cuando entrás a tu casa.</p></div>
        <QuoteForm whatsappLink={whatsappLink} />
      </section>
    </PageIntro>
  );
}

function QuoteForm({ whatsappLink }: { whatsappLink: (msg?: string) => string }) {
  const [sent, setSent] = useState(false);
  function submit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const data = new FormData(event.currentTarget);
    const message = `Hola Elite, soy ${data.get('name')}.\nTeléfono: ${data.get('phone')}\nEmail: ${data.get('email')}\nTipo de mueble: ${data.get('furniture')}\nMedidas aproximadas: ${data.get('measures')}\nMaterial o color: ${data.get('material')}\nZona de entrega: ${data.get('zone')}\nComentarios: ${data.get('comments')}`;
    window.open(whatsappLink(message), '_blank', 'noopener,noreferrer');
    setSent(true);
  }
  if (sent) return <div className="flex min-h-[430px] flex-col items-center justify-center bg-white p-8 text-center"><span className="flex h-14 w-14 items-center justify-center rounded-full bg-wood text-white"><Check size={25} /></span><h2 className="mt-6 font-display text-3xl">Consulta lista.</h2><p className="mt-3 max-w-[300px] text-sm leading-6 text-stone">Se abrió WhatsApp con todos los datos ordenados para que podamos responderte.</p></div>;
  return (
    <form onSubmit={submit} className="grid gap-6 bg-white p-6 sm:grid-cols-2 sm:p-10">
      <Field label="Nombre" name="name" placeholder="Tu nombre" required />
      <Field label="Teléfono" name="phone" placeholder="11 2408-9472" required />
      <Field label="Email" name="email" type="email" placeholder="tu@email.com" required />
      <Field label="Tipo de mueble" name="furniture" as="select" options={['Cocina', 'Placard o vestidor', 'Living', 'Escritorio', 'Baño', 'Otro']} required />
      <Field label="Medidas aproximadas" name="measures" placeholder="Ancho x alto x profundidad" />
      <Field label="Material o color preferido" name="material" placeholder="Ej. Roble, blanco, verde oliva" />
      <Field label="Zona de entrega" name="zone" placeholder="Localidad / provincia" required />
      <Field label="Comentarios" name="comments" placeholder="Contanos un poco más" as="textarea" />
      <button type="submit" className="button-dark sm:col-span-2 sm:justify-center">Enviar por WhatsApp <MessageCircle size={16} /></button>
    </form>
  );
}

type FieldProps = { label: string; name: string; placeholder?: string; type?: string; as?: 'input' | 'select' | 'textarea'; options?: string[]; required?: boolean };
function Field({ label, name, placeholder, type = 'text', as = 'input', options = [], required = false }: FieldProps) {
  return <label className="field"><span>{label}</span>{as === 'select' ? <select name={name} defaultValue="" required={required}><option value="" disabled>Seleccioná una opción</option>{options.map((option) => <option key={option}>{option}</option>)}</select> : as === 'textarea' ? <textarea name={name} placeholder={placeholder} rows={4} required={required} /> : <input name={name} type={type} placeholder={placeholder} required={required} />}</label>;
}

function Materials() {
  return (
    <PageIntro eyebrow="Materiales honestos" title={<>Simple de elegir,<br /><em>fácil de cuidar.</em></>} copy="Trabajamos principalmente con aglomerado y melamina." pageClass="bg-white">
      <div className="mx-auto max-w-[1320px] px-5 py-16 lg:px-10 lg:py-24">
        <div className="grid gap-12 lg:grid-cols-2">
          <div><h2 className="font-display text-4xl">Aglomerado y melamina</h2><p className="mt-6 text-sm leading-7 text-stone">El aglomerado es un tablero formado por partículas de madera prensadas con recubrimiento de melamina.</p></div>
          <div className="bg-bone p-7 sm:p-10">
            <p className="eyebrow">Muestrario</p>
            <div className="mt-8 grid grid-cols-3 gap-4 sm:grid-cols-6 lg:grid-cols-3">
              {materialSamples.map((sample) => (
                <div key={sample.name}><div className="aspect-square border border-charcoal/10" style={{ backgroundColor: sample.value }} /><p className="mt-2 text-[10px] font-semibold leading-4 text-stone">{sample.name}</p></div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </PageIntro>
  );
}

function About({ navigate, settings }: { navigate: (path: string) => void; settings: any }) {
  return (
    <PageIntro eyebrow="Nosotros" title={<>Un taller con los pies<br /><em>en el origen.</em></>} copy="Elite nace de hacer muebles honestos y bien pensados." pageClass="bg-bone">
      <section className="mx-auto grid max-w-[1320px] gap-12 px-5 py-16 lg:grid-cols-2 lg:items-center lg:px-10 lg:py-24">
        <div className="aspect-[.95] overflow-hidden rounded border">
          <img src={settings.about_image} alt="Taller" className="h-full w-full object-cover" loading="lazy" />
        </div>
        <div>
          <h2 className="font-display text-4xl leading-tight">{settings.about_title}</h2>
          <p className="mt-7 text-sm leading-7 text-stone">{settings.about_text}</p>
          <button onClick={() => navigate('/a-medida')} className="button-dark mt-8">Hablemos de tu proyecto <ArrowRight size={16} /></button>
        </div>
      </section>
    </PageIntro>
  );
}

function Contact({ settings, whatsappLink }: { settings: any; whatsappLink: (msg?: string) => string }) {
  const [sent, setSent] = useState(false);
  function submit(event: FormEvent<HTMLFormElement>) { event.preventDefault(); const data = new FormData(event.currentTarget); const message = `Hola Elite, soy ${data.get('name')}.\nMi consulta: ${data.get('message')}`; window.open(whatsappLink(message), '_blank', 'noopener,noreferrer'); setSent(true); }
  return (
    <PageIntro eyebrow="Contacto" title={<>Hablemos de<br /><em>tu espacio.</em></>} copy="Buenos Aires, Argentina." pageClass="bg-white">
      <section className="mx-auto grid max-w-[1320px] gap-14 px-5 py-16 lg:grid-cols-[.7fr_1.3fr] lg:px-10 lg:py-24">
        <div className="space-y-6">
          <a href={whatsappLink()} target="_blank" rel="noreferrer" className="flex items-start gap-4">
            <MessageCircle className="mt-1 text-wood" size={21} />
            <span><strong className="block text-sm">WhatsApp</strong><span className="mt-1 block text-sm text-stone">{settings.phone}</span></span>
          </a>
          <div className="flex items-start gap-4">
            <Mail className="mt-1 text-wood" size={21} />
            <span><strong className="block text-sm">Email</strong><span className="mt-1 block text-sm text-stone">{settings.email}</span></span>
          </div>
        </div>
        <form onSubmit={submit} className="grid gap-6 bg-bone p-6 sm:p-10">
          <Field label="Nombre" name="name" placeholder="Tu nombre" required />
          <Field label="Mensaje" name="message" placeholder="Mensaje..." as="textarea" required />
          <button type="submit" className="button-dark sm:justify-center">{sent ? '¡Enviado!' : 'Enviar'} <MessageCircle size={16} /></button>
        </form>
      </section>
    </PageIntro>
  );
}

function Footer({ navigate, settings }: { navigate: (path: string) => void; settings: any }) {
  return (
    <footer className="border-t border-charcoal/10 bg-charcoal px-5 py-16 text-white/70 lg:px-10">
      <div className="mx-auto max-w-[1320px] text-center text-xs text-white/50">{settings.phone} · {settings.email}</div>
    </footer>
  );
}

function WhatsAppButton({ whatsappLink }: { whatsappLink: (msg?: string) => string }) {
  return (
    <a href={whatsappLink()} target="_blank" rel="noreferrer" aria-label="WhatsApp" className="fixed bottom-6 right-6 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg">
      <MessageCircle size={26} />
    </a>
  );
}

// ----------------------------------------------------
// PANEL ADMIN CON PREVISUALIZACIONES VISUALES COMPLETAS
// ----------------------------------------------------
function Admin({ navigate, categories, onCategoryAdded }: { navigate: (path: string) => void; categories: string[]; onCategoryAdded: () => void }) {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [loading, setLoading] = useState(false);
  const [user, setUser] = useState<any>(null);

  // Muebles
  const [title, setTitle] = useState('');
  const [description, setDescription] = useState('');
  const [price, setPrice] = useState('');
  const [category, setCategory] = useState(categories[0] || 'Amoblamientos de cocina');
  const [file, setFile] = useState<File | null>(null);
  const [previewUrl, setPreviewUrl] = useState<string>('');
  const [dbProducts, setDbProducts] = useState<any[]>([]);

  // Categorías
  const [newCatName, setNewCatName] = useState('');

  // Parametrización Web + Favicon + Previews completas
  const [heroTitle, setHeroTitle] = useState('');
  const [phone, setPhone] = useState('');
  const [siteEmail, setSiteEmail] = useState('');
  const [whatsapp, setWhatsapp] = useState('');
  const [aboutTitle, setAboutTitle] = useState('');
  const [aboutText, setAboutText] = useState('');
  const [aboutImageFile, setAboutImageFile] = useState<File | null>(null);
  const [aboutImagePreview, setAboutImagePreview] = useState<string>('');
  const [faviconFile, setFaviconFile] = useState<File | null>(null);
  const [faviconPreview, setFaviconPreview] = useState<string>('');

  const loadData = async () => {
    const { data: prodData } = await supabase.from('products').select('*').order('created_at', { ascending: false });
    if (prodData) setDbProducts(prodData);

    const { data: setmData } = await supabase.from('site_settings').select('*').eq('id', 1).single();
    if (setmData) {
      setHeroTitle(setmData.hero_title || '');
      setPhone(setmData.phone || '');
      setSiteEmail(setmData.email || '');
      setWhatsapp(setmData.whatsapp || '');
      setAboutTitle(setmData.about_title || '');
      setAboutText(setmData.about_text || '');
      if (setmData.about_image) setAboutImagePreview(setmData.about_image);
      if (setmData.favicon_url) setFaviconPreview(setmData.favicon_url);
    }
  };

  useEffect(() => {
    if (user) loadData();
  }, [user]);

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const selectedFile = e.target.files?.[0] || null;
    setFile(selectedFile);
    if (selectedFile) setPreviewUrl(URL.createObjectURL(selectedFile));
  };

  const handleFaviconChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const selected = e.target.files?.[0] || null;
    setFaviconFile(selected);
    if (selected) setFaviconPreview(URL.createObjectURL(selected));
  };

  const handleAboutImageChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const selected = e.target.files?.[0] || null;
    setAboutImageFile(selected);
    if (selected) setAboutImagePreview(URL.createObjectURL(selected));
  };

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoading(true);
    const { data, error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) alert('Error: ' + error.message);
    else setUser(data.user);
    setLoading(false);
  };

  const handleAddCategory = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newCatName.trim()) return;
    const { error } = await supabase.from('categories').insert([{ name: newCatName.trim() }]);
    if (error) alert('Error: ' + error.message);
    else { alert('¡Categoría creada!'); setNewCatName(''); onCategoryAdded(); }
  };

  const handleUploadProduct = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!file) return alert('Seleccioná una imagen');
    setLoading(true);
    const fileName = `${Math.random()}.${file.name.split('.').pop()}`;
    const { error: uploadError } = await supabase.storage.from('product-images').upload(fileName, file);
    if (uploadError) return alert('Error subiendo imagen: ' + uploadError.message);

    const { data: urlData } = supabase.storage.from('product-images').getPublicUrl(fileName);
    const { error: insertError } = await supabase.from('products').insert([
      { title, description, price: price ? parseFloat(price) : 0, category, image_url: urlData.publicUrl },
    ]);

    if (insertError) alert('Error guardando mueble: ' + insertError.message);
    else { alert('¡Mueble subido!'); setTitle(''); setDescription(''); setPrice(''); setFile(null); setPreviewUrl(''); loadData(); }
    setLoading(false);
  };

  const handleDeleteProduct = async (id: string) => {
    if (!confirm('¿Seguro que querés eliminar este mueble?')) return;
    await supabase.from('products').delete().eq('id', id);
    loadData();
  };

  const handleSaveSettings = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoading(true);
    let uploadedFavicon = faviconPreview;
    let uploadedAboutImage = aboutImagePreview;

    if (faviconFile) {
      const fileName = `favicon-${Math.random()}.${faviconFile.name.split('.').pop()}`;
      await supabase.storage.from('product-images').upload(fileName, faviconFile);
      uploadedFavicon = supabase.storage.from('product-images').getPublicUrl(fileName).data.publicUrl;
    }

    if (aboutImageFile) {
      const fileName = `about-${Math.random()}.${aboutImageFile.name.split('.').pop()}`;
      await supabase.storage.from('product-images').upload(fileName, aboutImageFile);
      uploadedAboutImage = supabase.storage.from('product-images').getPublicUrl(fileName).data.publicUrl;
    }

    const { error } = await supabase.from('site_settings').update({
      hero_title: heroTitle,
      phone,
      email: siteEmail,
      whatsapp,
      about_title: aboutTitle,
      about_text: aboutText,
      about_image: uploadedAboutImage,
      favicon_url: uploadedFavicon,
    }).eq('id', 1);

    if (error) alert('Error: ' + error.message);
    else { alert('¡Ajustes y parametrización actualizados!'); window.location.reload(); }
    setLoading(false);
  };

  return (
    <div className="min-h-screen bg-bone p-6">
      <div className="mx-auto max-w-6xl">
        <button onClick={() => navigate('/')} className="mb-6 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-stone hover:text-wood">
          <ArrowLeft size={16} /> Volver al sitio web
        </button>

        {!user ? (
          <form onSubmit={handleLogin} className="bg-white p-8 rounded-lg shadow-md space-y-4 max-w-md mx-auto">
            <h2 className="text-2xl font-bold mb-2">Panel Administrador</h2>
            <input type="email" placeholder="Email" className="w-full border p-3 rounded text-sm" value={email} onChange={(e) => setEmail(e.target.value)} required />
            <input type="password" placeholder="Contraseña" className="w-full border p-3 rounded text-sm" value={password} onChange={(e) => setPassword(e.target.value)} required />
            <button type="submit" disabled={loading} className="w-full bg-charcoal text-white py-3 rounded font-bold uppercase text-xs">
              {loading ? 'Ingresando...' : 'Iniciar Sesión'}
            </button>
          </form>
        ) : (
          <div className="space-y-8">
            {/* PARAMETRIZACIÓN GENERAL DEL SITIO CON PREVIEWS */}
            <div className="bg-white p-8 rounded-lg shadow-md space-y-6">
              <div className="flex justify-between items-center border-b pb-4">
                <h2 className="text-2xl font-bold">Parametrización del Sitio Web</h2>
                <button onClick={() => supabase.auth.signOut().then(() => setUser(null))} className="text-xs text-red-600 font-bold uppercase">Cerrar Sesión</button>
              </div>

              <form onSubmit={handleSaveSettings} className="space-y-6">
                
                {/* 1. Favicon con Previsualización */}
                <div className="border border-wood/20 bg-bone/40 p-5 rounded-lg space-y-3">
                  <div className="flex items-center justify-between">
                    <h3 className="font-bold text-sm">Ícono de la Pestaña (Favicon)</h3>
                    {faviconPreview && (
                      <div className="flex items-center gap-2 bg-white px-3 py-1.5 rounded border shadow-sm">
                        <img src={faviconPreview} alt="Favicon" className="w-6 h-6 object-contain" />
                        <span className="text-[10px] text-stone font-bold uppercase">Vista previa</span>
                      </div>
                    )}
                  </div>
                  <input type="file" accept="image/*" className="w-full border p-2.5 rounded bg-white text-xs" onChange={handleFaviconChange} />
                  <p className="text-[11px] text-amber-800">📏 Recomendado: 32x32px o 64x64px en PNG transparente.</p>
                </div>

                {/* 2. Título Principal (Hero) con Previsualización Visual en Vivo */}
                <div className="border border-wood/20 bg-bone/40 p-5 rounded-lg space-y-4">
                  <h3 className="font-bold text-sm uppercase text-wood">Título Principal (Hero) & Banner</h3>
                  <div>
                    <label className="block text-xs font-bold uppercase mb-1">Texto del Título Hero</label>
                    <input type="text" className="w-full border p-3 rounded text-sm bg-white" value={heroTitle} onChange={(e) => setHeroTitle(e.target.value)} required />
                  </div>
                  <div>
                    <p className="text-xs font-bold uppercase mb-2 text-stone">Previsualización del Banner en Vivo</p>
                    <div className="relative h-48 rounded-lg overflow-hidden bg-charcoal text-white flex items-end p-5 shadow-inner">
                      <img src="/WhatsApp_Image_2026-10-28_at_10.46.54_(2).jpeg" alt="Hero background" className="absolute inset-0 w-full h-full object-cover opacity-60" />
                      <div className="absolute inset-0 bg-gradient-to-r from-charcoal via-charcoal/40 to-transparent" />
                      <div className="relative z-10">
                        <span className="text-[9px] uppercase tracking-widest text-wood-light font-bold">Elite / Diseño de origen</span>
                        <h4 className="font-display text-xl sm:text-2xl leading-tight mt-1">
                          Diseño de origen <span className="text-wood-light italic font-normal">{heroTitle || 'Escribe un título...'}</span>
                        </h4>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Contacto y WhatsApp */}
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label className="block text-xs font-bold uppercase mb-1">WhatsApp (ej: 5491124089472)</label>
                    <input type="text" className="w-full border p-3 rounded text-sm" value={whatsapp} onChange={(e) => setWhatsapp(e.target.value)} required />
                  </div>
                  <div>
                    <label className="block text-xs font-bold uppercase mb-1">Teléfono visible</label>
                    <input type="text" className="w-full border p-3 rounded text-sm" value={phone} onChange={(e) => setPhone(e.target.value)} required />
                  </div>
                  <div className="sm:col-span-2">
                    <label className="block text-xs font-bold uppercase mb-1">Email institucional</label>
                    <input type="text" className="w-full border p-3 rounded text-sm" value={siteEmail} onChange={(e) => setSiteEmail(e.target.value)} required />
                  </div>
                </div>

                {/* 3. Sección Nosotros con Previsualización de Imagen */}
                <div className="border-t pt-6 space-y-4">
                  <h3 className="font-bold text-sm uppercase text-wood">Sección Nosotros</h3>
                  <div className="grid grid-cols-1 lg:grid-cols-[1fr_240px] gap-6 items-start">
                    <div className="space-y-4">
                      <div>
                        <label className="block text-xs font-bold uppercase mb-1">Título de la sección</label>
                        <input type="text" className="w-full border p-3 rounded text-sm" value={aboutTitle} onChange={(e) => setAboutTitle(e.target.value)} required />
                      </div>
                      <div>
                        <label className="block text-xs font-bold uppercase mb-1">Texto descriptivo</label>
                        <textarea className="w-full border p-3 rounded text-sm" rows={4} value={aboutText} onChange={(e) => setAboutText(e.target.value)} required />
                      </div>
                    </div>
                    <div>
                      <label className="block text-xs font-bold uppercase mb-1">Imagen del Taller</label>
                      <div className="aspect-[4/3] bg-bone border rounded overflow-hidden mb-2 shadow-sm">
                        {aboutImagePreview ? (
                          <img src={aboutImagePreview} alt="Nosotros preview" className="w-full h-full object-cover" />
                        ) : (
                          <div className="flex items-center justify-center h-full text-[11px] text-stone">Sin imagen</div>
                        )}
                      </div>
                      <input type="file" accept="image/*" className="w-full border p-2 rounded bg-bone text-xs" onChange={handleAboutImageChange} />
                      <p className="text-[10px] text-stone mt-1">Recomendado: 1200x800px</p>
                    </div>
                  </div>
                </div>

                <button type="submit" disabled={loading} className="w-full bg-charcoal text-white py-3 rounded font-bold uppercase text-xs hover:bg-wood">
                  Guardar Todos los Ajustes
                </button>
              </form>
            </div>

            {/* CATEGORÍAS */}
            <div className="bg-white p-8 rounded-lg shadow-md space-y-4">
              <h2 className="text-xl font-bold border-b pb-3">Categorías Dinámicas</h2>
              <div className="flex flex-wrap gap-2 mb-2">
                {categories.map((cat) => <span key={cat} className="bg-bone border px-3 py-1.5 text-xs font-semibold rounded">{cat}</span>)}
              </div>
              <form onSubmit={handleAddCategory} className="flex gap-3">
                <input type="text" placeholder="Nueva categoría" className="flex-1 border p-3 rounded text-sm" value={newCatName} onChange={(e) => setNewCatName(e.target.value)} required />
                <button type="submit" className="bg-charcoal text-white px-5 py-3 rounded text-xs font-bold uppercase">Agregar</button>
              </form>
            </div>

            {/* CARGA DE MUEBLE CON LIVE PREVIEW */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
              <div className="bg-white p-8 rounded-lg shadow-md space-y-4">
                <h2 className="text-2xl font-bold border-b pb-4">Cargar Nuevo Mueble</h2>
                <form onSubmit={handleUploadProduct} className="space-y-4">
                  <input type="text" placeholder="Título del mueble" className="w-full border p-3 rounded text-sm" value={title} onChange={(e) => setTitle(e.target.value)} required />
                  <div className="grid grid-cols-2 gap-4">
                    <input type="number" placeholder="Precio ARS" className="w-full border p-3 rounded text-sm" value={price} onChange={(e) => setPrice(e.target.value)} />
                    <select className="w-full border p-3 rounded text-sm" value={category} onChange={(e) => setCategory(e.target.value)}>
                      {categories.map((cat) => <option key={cat} value={cat}>{cat}</option>)}
                    </select>
                  </div>
                  <textarea placeholder="Descripción..." className="w-full border p-3 rounded text-sm" rows={3} value={description} onChange={(e) => setDescription(e.target.value)} />
                  <input type="file" accept="image/*" className="w-full border p-3 rounded bg-bone text-xs" onChange={handleFileChange} required />
                  <p className="text-[11px] text-blue-900">📐 Recomendado: 1200x900px (4:3).</p>
                  <button type="submit" disabled={loading} className="w-full bg-wood text-white py-3 rounded font-bold uppercase text-xs hover:bg-charcoal">
                    {loading ? 'Guardando...' : 'Guardar Mueble'}
                  </button>
                </form>
              </div>

              {/* Previsualización en Vivo del Mueble */}
              <div className="bg-white p-8 rounded-lg shadow-md space-y-4 sticky top-6">
                <h3 className="text-xl font-bold border-b pb-3">Vista Previa del Mueble</h3>
                <div className="border rounded bg-bone/50 p-4">
                  <div className="aspect-[1.1] bg-stone-light overflow-hidden rounded">
                    {previewUrl ? <img src={previewUrl} alt="Preview" className="w-full h-full object-cover" /> : <div className="h-full flex items-center justify-center text-xs text-stone">Sin imagen</div>}
                  </div>
                  <p className="mt-3 text-[9px] font-bold uppercase text-wood">{category}</p>
                  <h4 className="font-display text-2xl mt-1">{title || 'Título del mueble'}</h4>
                  <p className="text-xs text-stone mt-1">{description || 'Descripción del mueble...'}</p>
                </div>
              </div>
            </div>

            {/* TABLA DE PRODUCTOS */}
            <div className="bg-white p-8 rounded-lg shadow-md space-y-4">
              <h3 className="text-xl font-bold border-b pb-3">Muebles Cargados ({dbProducts.length})</h3>
              <div className="divide-y">
                {dbProducts.map((prod) => (
                  <div key={prod.id} className="py-4 flex items-center justify-between">
                    <div className="flex items-center gap-4">
                      <img src={prod.image_url} alt={prod.title} className="w-14 h-14 object-cover rounded border" />
                      <div>
                        <h4 className="font-bold text-sm">{prod.title}</h4>
                        <span className="text-xs text-wood font-semibold">{prod.category}</span>
                      </div>
                    </div>
                    <button onClick={() => handleDeleteProduct(prod.id)} className="text-xs bg-red-100 text-red-600 px-3 py-2 rounded font-bold">Eliminar</button>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}